# 100% FREE - no card required.
# Gemini keys (LLM + embeddings): https://aistudio.google.com/apikey
# Multiple keys comma diye dao - auto rotate hobe, rate-limit ভাগ হবে.
# Example: GOOGLE_API_KEYS=AIza_key1,AIza_key2,AIza_key3
GOOGLE_API_KEYS=your_google_ai_studio_key_here

# Optional fallback (also free, no card): https://console.groq.com
# Gemini quota sesh hole auto Groq (llama-3.3-70b) e jabe.
# GROQ_API_KEY=gsk_...

# Free models (optional overrides)
GEMINI_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=models/gemini-embedding-001
GROQ_MODEL=openai/gpt-oss-20b

# Security (change in production)
ADMIN_API_KEY=change-me-in-production

# Application Settings
APP_ENV=development
